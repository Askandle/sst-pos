rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Profiles Collection
    match /profiles/{profileId} {
      allow get: if isValidId(profileId);
      allow list: if true;
      allow write: if isValidId(profileId);
    }

    // Products Collection
    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow write: if isValidId(productId);
    }

    // Services Collection
    match /services/{serviceId} {
      allow get: if isValidId(serviceId);
      allow list: if true;
      allow write: if isValidId(serviceId);
    }

    // Expenses Collection
    match /expenses/{expenseId} {
      allow get: if isValidId(expenseId);
      allow list: if true;
      allow write: if isValidId(expenseId);
    }

    // Transactions Collection
    match /transactions/{transactionId} {
      allow get: if isValidId(transactionId);
      allow list: if true;
      allow write: if isValidId(transactionId);
    }
  }
}
